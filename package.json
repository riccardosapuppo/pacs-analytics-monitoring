{
  "name": "pacs-analytics-monitoring",
  "version": "1.0.0",
  "private": true,
  "description": "Analytics over an image archive whose schema you do not own, cannot change, and that is different at every installation",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test test/*.test.js",
    "measure": "node tools/measure.mjs",
    "check:dialects": "node tools/check-dialects.mjs",
    "check:screen": "node tools/through-the-screen.mjs",
    "check:mark": "node tools/check-mark.mjs",
    "check:serving": "node tools/how-it-is-served.mjs",
    "screenshots": "node tools/screenshots.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.48.0"
  },
  "license": "MIT",
  "author": "Riccardo Sapuppo"
}
