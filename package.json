{
  "name": "pacs-analytics-monitoring",
  "version": "1.0.0",
  "private": true,
  "description": "Analytics over an image archive whose schema you do not own, cannot change, and that is different at every installation",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "measure": "node tools/measure.ts",
    "check:dialects": "node tools/check-dialects.ts",
    "check:screen": "node tools/through-the-screen.ts",
    "check:mark": "node tools/check-mark.ts",
    "check:serving": "node tools/how-it-is-served.ts",
    "screenshots": "node tools/screenshots.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright-core": "^1.48.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "author": "Riccardo Sapuppo"
}
